{
  "name": "split-ledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared expenses for groups: split bills, track balances and settle up in as few transfers as possible.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace @split-ledger/api & npm run dev --workspace @split-ledger/web",
    "dev:api": "npm run dev --workspace @split-ledger/api",
    "dev:web": "npm run dev --workspace @split-ledger/web",
    "build": "npm run build --workspace @split-ledger/web && npm run build --workspace @split-ledger/api",
    "start": "node apps/api/dist/server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:vercel": "node scripts/build-vercel.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.8",
    "eslint": "^9.36.0",
    "fast-check": "^4.10.2",
    "globals": "^16.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.10"
    },
    "vite": "8.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
